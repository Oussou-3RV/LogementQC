<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-annonces-table" author="ouss">
        <createTable tableName="annonces">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="titre" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="description_courte" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>

            <column name="description_longue" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="montant_mensuel" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>

            <column name="date_disponibilite" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="photos" type="TEXT"/>

            <column name="rue" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="ville" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="province" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="code_postal" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="pays" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="latitude" type="DOUBLE PRECISION"/>

            <column name="longitude" type="DOUBLE PRECISION"/>

            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="nombre_consultations" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index pour optimiser les recherches -->
        <createIndex indexName="idx_annonces_user_id" tableName="annonces">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_annonces_ville" tableName="annonces">
            <column name="ville"/>
        </createIndex>

        <createIndex indexName="idx_annonces_active" tableName="annonces">
            <column name="active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>