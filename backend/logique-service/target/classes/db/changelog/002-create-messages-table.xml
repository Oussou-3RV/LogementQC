<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-messages-table" author="ouss">
        <createTable tableName="messages">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="annonce_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="expediteur_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="destinataire_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>

            <column name="sujet" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="contenu" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="lu" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index pour optimiser les recherches -->
        <createIndex indexName="idx_messages_annonce_id" tableName="messages">
            <column name="annonce_id"/>
        </createIndex>

        <createIndex indexName="idx_messages_expediteur_id" tableName="messages">
            <column name="expediteur_id"/>
        </createIndex>

        <createIndex indexName="idx_messages_destinataire_id" tableName="messages">
            <column name="destinataire_id"/>
        </createIndex>

        <createIndex indexName="idx_messages_lu" tableName="messages">
            <column name="lu"/>
        </createIndex>

        <!-- Clé étrangère vers annonces -->
        <addForeignKeyConstraint
                baseTableName="messages"
                baseColumnNames="annonce_id"
                constraintName="fk_messages_annonce"
                referencedTableName="annonces"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>